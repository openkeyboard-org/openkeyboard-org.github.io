---
// Shared site header. The "Projects" link uses /#projects so it works from
// any page (on the homepage it resolves to the same-page anchor).
---

<header>
  <nav>
    <a href="/" class="logo">
      <picture>
        <!-- The single-line logo is too wide to share a row with the links on
             phones, so swap in the two-line lockup there. -->
        <source
          media="(max-width: 30rem)"
          srcset="/brand/logo-horizontal-stacked-inverted.svg"
          width="85"
          height="36"
        />
        <img src="/brand/logo-horizontal-inverted.svg" alt="OpenKeyboard" width="267" height="24" />
      </picture>
    </a>
    <ul>
      <li><a href="/#projects">Projects</a></li>
      <li>
        <a href="https://github.com/openkeyboard-org" target="_blank" rel="noopener noreferrer">GitHub</a>
      </li>
    </ul>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: var(--color-bg);
    padding: 0 2rem;
  }

  /* Logo-palette stripe along the bottom edge. */
  header::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--ok-stripe);
  }

  nav {
    max-width: 64rem;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 4rem;
    gap: 1rem;
  }

  .logo {
    display: block;
    flex-shrink: 0;
  }

  .logo img {
    display: block;
    height: 24px;
    width: auto;
  }

  nav ul {
    list-style: none;
    display: flex;
    gap: 1.5rem;
  }

  nav ul a {
    color: var(--color-text);
    font-weight: 500;
  }

  nav ul a:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 30rem) {
    header {
      padding: 0 1rem;
    }

    .logo img {
      height: 36px;
    }

    nav ul {
      gap: 1rem;
    }
  }
</style>
