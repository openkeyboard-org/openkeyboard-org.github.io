---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="OpenKeyboard">
  <Header />

  <main>
    <section class="hero">
      <h1>
        <img
          src="/brand/logo-horizontal-stacked-inverted.svg"
          alt="OpenKeyboard"
          width="416"
          height="176"
        />
      </h1>
      <p class="tagline">Open source keyboard tools, designs and firmware.</p>
      <div class="actions">
        <a
          href="https://github.com/openkeyboard-org"
          class="btn btn-primary"
          target="_blank"
          rel="noopener noreferrer"
        >
          View on GitHub
        </a>
      </div>
    </section>

    <section class="features">
      <div class="feature-card">
        <div class="feature-icon">🔧</div>
        <h2>Open Source</h2>
        <p>100% open source and freely available.</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">🌍</div>
        <h2>Community First</h2>
        <p>Built by keyboard enthusiasts, for keyboard enthusiasts.</p>
      </div>
    </section>

    <section id="projects" class="projects">
      <h2 class="section-title">Projects</h2>
      <div class="project-grid">
        <a href="/opendongle" class="project-card accent-yellow">
          <div class="project-icon" aria-hidden="true">📡</div>
          <div class="project-body">
            <h3>OpenDongle</h3>
            <p>
              A compact, open-source USB Type-A 2.4 GHz wireless receiver, small enough to fit
              inside a standard nano-receiver shell. Built on WCH RISC-V wireless MCUs, with
              two ready-to-fabricate hardware variants.
            </p>
            <div class="project-tags">
              <span class="tag">2.4 GHz receiver</span>
              <span class="tag">KiCad hardware</span>
              <span class="tag">RISC-V firmware</span>
            </div>
            <span class="project-link">Learn more &rarr;</span>
          </div>
        </a>
        <a href="/opencontroller" class="project-card accent-orange">
          <div class="project-icon" aria-hidden="true">📶</div>
          <div class="project-body">
            <h3>OpenController</h3>
            <p>
              The keyboard side of the link: a WCH CH592F wireless module that adds 2.4 GHz
              wireless to a QMK keyboard, driven by the host MCU over UART and paired with
              OpenDongle.
            </p>
            <div class="project-tags">
              <span class="tag">2.4 GHz link</span>
              <span class="tag">CH592F firmware</span>
              <span class="tag">A/B updates</span>
            </div>
            <span class="project-link">Learn more &rarr;</span>
          </div>
        </a>
        <a href="/openboot" class="project-card accent-green">
          <div class="project-icon" aria-hidden="true">🥾</div>
          <div class="project-body">
            <h3>OpenBoot</h3>
            <p>
              An 8 KiB IAP bootloader for WCH RISC-V microcontrollers. One protocol over USB
              HID or UART, A/B slots so a failed update can’t brick the device, and a
              cross-platform Rust flashing tool.
            </p>
            <div class="project-tags">
              <span class="tag">Bootloader</span>
              <span class="tag">A/B updates</span>
              <span class="tag">Rust CLI</span>
            </div>
            <span class="project-link">Learn more &rarr;</span>
          </div>
        </a>
      </div>
    </section>
  </main>

  <footer>
    <p>
      &copy; {new Date().getFullYear()} OpenKeyboard contributors
    </p>
  </footer>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 6rem 0 4rem;
  }

  h1 {
    margin-bottom: 2rem;
  }

  h1 img {
    display: block;
    width: min(26rem, 100%);
    height: auto;
    margin: 0 auto;
  }

  .tagline {
    font-size: 1.4rem;
    font-weight: 300;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
  }

  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
    padding: 4rem 0;
  }

  .feature-card {
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 2rem;
  }

  .feature-icon {
    font-size: 2rem;
    margin-bottom: 1rem;
  }

  .feature-card h2 {
    font-size: 1.25rem;
    margin-bottom: 0.5rem;
  }

  .feature-card p {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .projects {
    padding: 2rem 0 4rem;
    /* Offset the sticky 4rem header so #projects lands below it. */
    scroll-margin-top: 5rem;
  }

  .section-title {
    font-size: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .project-grid {
    display: grid;
    gap: 1.5rem;
  }

  .project-card {
    position: relative;
    overflow: hidden;
    display: flex;
    gap: 1.5rem;
    background: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 2rem;
    color: inherit;
    transition: border-color 0.2s, transform 0.2s;
  }

  /* The project's colour from the logo palette, across the top edge. */
  .project-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--color-accent);
  }

  .project-card:hover {
    text-decoration: none;
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: border-color 0.2s;
    }

    .project-card:hover {
      transform: none;
    }
  }

  .project-icon {
    font-size: 2.5rem;
    line-height: 1;
  }

  .project-body h3 {
    font-size: 1.4rem;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  .project-body p {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .project-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .tag {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-accent-hover);
    background: color-mix(in srgb, var(--color-accent) 14%, transparent);
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
  }

  /* The lighter shade keeps orange legible on the card surface. */
  .project-link {
    font-weight: 600;
    color: var(--color-accent-hover);
  }
</style>
